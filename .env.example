# Graph store
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=granular-password

# Vector store
PGVECTOR_DSN=postgresql://granular:granular-password@localhost:5432/granular

# LLM / embeddings (OpenAI, Anthropic, or AWS Bedrock)
# Option 1: OpenAI (both extraction and embeddings)
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# Extraction: chat model that verifies each concept->CS2023 alignment, rejecting
# embedding false positives (e.g. "solar car construction" -> "Software
# Construction"). Follows OPENAI/ANTHROPIC/BEDROCK_LLM_MODEL provider by default.
# Set empty to disable verification.
# ALIGNMENT_VERIFY_MODEL=openai/gpt-4o-mini

# Advisory API: chat model used to interpret a student's search query and
# select the knowledge units that genuinely match their intent (reranks the
# embedding-retrieved candidates for precision). Defaults to openai/gpt-4o.
# Set to empty to disable LLM reranking (embedding-only, lower precision).
# RESOLUTION_LLM_MODEL=openai/gpt-4o

# Option 2: Anthropic Claude (concept extraction only)
# Note: Anthropic does not provide embeddings; use OpenAI's text-embedding-3-small
# Uncomment and configure to use Claude instead of GPT:
# ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE
# ANTHROPIC_LLM_MODEL=claude-3-5-haiku-20241022

# Option 3: AWS Bedrock (recommended for cost — Nova or Claude)
# Note: Requires AWS credentials configured (env vars or ~/.aws/credentials)
# Uncomment and configure:
# BEDROCK_LLM_MODEL=us.amazon.nova-lite-v1:0
# OPENAI_API_KEY=sk-...  (still required for embeddings)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# AWS_REGION=us-east-1  (or your Bedrock region)

# Frontend origin (for CORS)
FRONTEND_ORIGIN=http://localhost:3000
