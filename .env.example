# Graph store
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=granular-password

# Vector store
PGVECTOR_DSN=postgresql://granular:granular-password@localhost:5432/granular

# LLM / embeddings (OpenAI or Anthropic)
# Option 1: OpenAI (both extraction and embeddings)
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# Option 2: Anthropic Claude (concept extraction only)
# Note: Anthropic does not provide embeddings; use OpenAI's text-embedding-3-small
# Uncomment and configure to use Claude instead of GPT:
# ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE
# ANTHROPIC_LLM_MODEL=claude-3-5-haiku-20241022

# Frontend origin (for CORS)
FRONTEND_ORIGIN=http://localhost:3000
